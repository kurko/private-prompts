#!/usr/bin/env bash
set -euo pipefail

# Lint text for AI writing anti-patterns, and auto-fix curly quotes.
#
# Usage:
#   lint-prose <file>         # fixes curly quotes in place, lints the rest
#   echo "some text" | lint-prose   # fixed text -> stdout, diagnostics -> stderr
#
# Diagnostics go to stderr so that stdout carries the corrected text in pipe
# mode. Exit code still drives pass/fail: 0 = clean, 1 = violations remain.

file=""
if [ $# -gt 0 ]; then
  # File mode
  if [ ! -f "$1" ]; then
    echo "FAIL: file not found: $1" >&2
    exit 1
  fi
  file="$1"
  input="$(cat "$file")"
else
  # Pipe mode
  if [ -t 0 ]; then
    echo "Usage: lint-prose <file>" >&2
    echo "       echo \"text\" | lint-prose" >&2
    exit 1
  fi
  input="$(cat)"
fi

# Auto-fix curly quotes -> straight quotes. Alex types straight quotes on his
# machine, so curly ones are a tell that the text came from somewhere else.
# The substitution is mechanical and lossless, so fix it rather than making a
# human decide (unlike em dashes, which need a real rewrite).
#
# Single: ' U+2018  ' U+2019  ‚ U+201A  ‛ U+201B
# Double: " U+201C  " U+201D  „ U+201E  ‟ U+201F
#
# Each character gets its own -e expression: bracket expressions containing
# multibyte characters are unreliable in BSD sed on macOS.
fixed="$(printf '%s' "$input" | sed \
  -e "s/‘/'/g" \
  -e "s/’/'/g" \
  -e "s/‚/'/g" \
  -e "s/‛/'/g" \
  -e 's/“/"/g' \
  -e 's/”/"/g' \
  -e 's/„/"/g' \
  -e 's/‟/"/g')"

if [ "$fixed" != "$input" ]; then
  curly_count="$(printf '%s' "$input" \
    | grep -o -e '‘' -e '’' -e '‚' -e '‛' -e '“' -e '”' -e '„' -e '‟' \
    | wc -l | tr -d ' ')" || curly_count="?"
  if [ -n "$file" ]; then
    printf '%s\n' "$fixed" > "$file"
    echo "FIXED: replaced $curly_count curly quote(s) with straight quotes in $file" >&2
  else
    echo "FIXED: replaced $curly_count curly quote(s) with straight quotes" >&2
  fi
fi

# Everything below lints the corrected text.
input="$fixed"

fail=0

# Check for em dashes (U+2014). Literal character, not \x{2014}:
# BSD grep on macOS has no -P (PCRE), and a failing grep made this check
# silently pass forever.
if echo "$input" | grep -n '—' >&2; then
  echo "FAIL: em dashes found. Replace with commas, parentheses, or separate sentences." >&2
  fail=1
fi

# Banned framing phrases: they assert importance or build tension without
# adding information. Name the concrete thing and state it directly.
banned_phrases=(
  "here's the thing"
  "bottom line"
  "the catch:"
  "the kicker:"
  "the gap:"
  "what matters"
  "not flashy"
)

for phrase in "${banned_phrases[@]}"; do
  if echo "$input" | grep -Fin "$phrase" >&2; then
    echo "FAIL: banned framing phrase (\"$phrase\"). State the thing directly." >&2
    fail=1
  fi
done

# AI-tell patterns (regex). Sources: Wikipedia "Signs of AI writing" and the
# 38 patterns in Simon Willison's llm-cliche-highlighter. Each entry is
# "label|extended-regex". Only low-false-positive patterns belong here; the
# judgment-call patterns live in the SKILL.md anti-pattern list instead.
banned_patterns=(
  "verdict sentence|(that|this|it)('s| is| was) not nothing"
  "verdict sentence|('s| is| was) the (whole|entire) (point|game|thing|story|trick|pitch|idea|job)"
  "verdict sentence|(that|this)('s| is| was) why .{0,60}(matters|mattered|counts|counted)\b"
  "verdict sentence|('s| is| was) the part that"
  "staged reveal|the punchline"
  "staged reveal|here('s| is) the (twist|thing|catch|kicker|rub)"
  "staged reveal|^turns out|[.!?] turns out|it turns out that"
  "therapist voice|worth naming"
  "therapist voice|sit with (that|this|it)\b"
  "announced sincerity|let('s| us) be (honest|real|blunt|clear)"
  "announced sincerity|i('ll| will) be honest"
  "announced sincerity|you already know"
  "announced sincerity|take my word for it"
  "negative parallelism|not (just|only|merely|simply) [^.,;]{1,60},? but( also)?\b"
  "negative parallelism|it('s| is) not [^,.;]{1,60}, it('s| is)"
  "cadence chain|\bno [a-z-]+, no [a-z-]+"
  "puffery|(stands?|stood|serves?|served) as a (testament|reminder)"
  "puffery|a testament to"
  "puffery|plays? a (crucial|pivotal|vital|key|central|critical|important) role"
  "puffery|(ever-)?(evolving|changing|shifting) landscape"
  "puffery|in today's (fast-paced|digital|modern|competitive|ever-)"
  "AI vocabulary|\b(delve|delves|delving|tapestry|multifaceted|pivotal|bustling|meticulous(ly)?|boasts?)\b"
  "AI vocabulary|\bunderscor(es|ed|ing) (the|its|his|her|their|our|how|that|a|an)\b"
  "didactic filler|it('s| is) (also )?(important|worth|crucial|essential|vital) to (note|remember|understand|mention)"
  "didactic filler|it('s| is) worth (noting|mentioning)|it should be noted"
  "participle tail|, (highlighting|underscoring|emphasizing|showcasing|reflecting|demonstrating|illustrating|signaling|solidifying|cementing|reinforcing|underlining) "
  "vague attribution|(experts|critics|observers|analysts) (argue|agree|note|suggest|believe|contend)"
  "boilerplate outlook|despite these challenges|challenges remain\b|remains to be seen|time will tell"
  "summary closer|in conclusion|in summary|to summarize"
)

for entry in "${banned_patterns[@]}"; do
  label="${entry%%|*}"
  regex="${entry#*|}"
  if echo "$input" | grep -Ein "$regex" >&2; then
    echo "FAIL: AI-tell pattern ($label). Delete the sentence or state the underlying fact plainly. Rewording is not a fix." >&2
    fail=1
  fi
done

# In pipe mode, hand the corrected text back on stdout.
if [ -z "$file" ]; then
  printf '%s\n' "$fixed"
fi

if [ "$fail" -eq 1 ]; then
  exit 1
fi

echo "PASS: no em dashes or banned phrases found." >&2
